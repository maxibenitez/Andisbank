{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Serilog": {
  "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.SQLite"],
  "MinimumLevel": "Debug",
  "WriteTo": [
      {
        "Name": "Console",
        "Args": { "restrictedToMinimumLevel": "Information" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/logfile.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Debug"
        }
      },
      {
        "Name": "SQLite",
        "Args": {
          "connectionString": "Data Source=logs/logdatabase.db",
          "restrictedToMinimumLevel": "Error"
        }
      }
    ]
  }
}


